# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
dist-placeholders/
.eggs/

# Virtual envs
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated demo/benchmark artifacts (regenerate with the scripts)
**/examples/outputs/
**/benchmarks/outputs/
*.ckpt

# Never commit partner data
data/partner/

# OS / editor
.DS_Store
.idea/
.vscode/

# Sphinx build output
docs/_build/

# docs/.jupyter_cache is deliberately NOT ignored. It is committed so Read the
# Docs renders example outputs without executing them (D20), and CI refreshes it
# on every push to main. See the nb_execution_mode comment in docs/conf.py.
